{% macro string_list(values) %}{{ "{" }}{% for value in values %}"{{ value }}"{{ ", " if not loop.last else "" }}{% endfor %}{{ "}" }}{% endmacro %}
#pragma once

#include <array>
#include <string_view>

namespace {{ namespace }}
{

// The layout name, which is also the root panel's id.
inline constexpr std::string_view Name = "{{ screen.name }}";

{% if screen.flat_ids %}
// Panel ids.
{% for id in screen.flat_ids %}
inline constexpr std::string_view {{ member_name(id, screen.name) }} = "{{ id }}";
{% endfor %}

{% endif %}
{% if screen.flat_variables %}
// Dialog variables.
{% for variable in screen.flat_variables %}
inline constexpr std::string_view {{ pascal_case(variable) }}Var = "{{ variable }}";
{% endfor %}

{% endif %}
{% if screen.blocks %}
// Repeated blocks: one struct per block, one array entry per index.
{% for block in screen.blocks %}
struct {{ block.struct_name }}
{
{% for member in block.members() %}
    std::string_view {{ member }};
{% endfor %}
};
inline constexpr std::array<{{ block.struct_name }}, {{ block.count }}> {{ block.array_name }}{
{% for index in range(block.count) %}
    {{ block.struct_name }}{{ string_list(block.ids(screen.name, index) + block.variables(index)) }},
{% endfor %}
};

{% endfor %}
{% endif %}
{% for prefix, modifiers in screen.modifiers.items() %}
inline constexpr std::array<std::string_view, {{ modifiers | length }}> {{ pascal_case(prefix) }}Names{{ string_list(modifiers) }};

{% endfor %}
}  // namespace {{ namespace }}
