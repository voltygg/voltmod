{% for code in class.accessors %}
{{ code.wrapper_return_type }} {{ code.name }}({{ code.getter_params }}) const { return Schema::{{ name }}{_e}.{{ code.name }}({{ code.index_argument }}); }
{% if code.setter %}
void Set{{ code.name }}({{ code.setter.wrapper_params }}) const { Schema::{{ name }}{_e}.Set{{ code.name }}({{ code.setter.arguments }}); }
{% endif %}
{% endfor %}
