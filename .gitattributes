# Conan hashes the bytes of the checked-out recipe, so a CRLF checkout on Windows
# produces a different recipe revision than Linux for the same commit - duplicate
# uploads, and a conan.lock that resolves on one platform but not the other.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.lib binary
*.a binary
*.so binary
*.dll binary
*.pdb binary
