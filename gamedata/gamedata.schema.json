{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "voltmod gamedata.jsonc",
  "description": "Where the engine keeps things. C++ owns every ABI (prototypes, field types) in VoltMod::Bindings; this file only says where to look. Re-verify after every CS2 update.",
  "type": "object",
  "additionalProperties": false,
  "required": ["build"],
  "properties": {
    "$schema": { "type": "string" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "verified"],
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "steam.inf ServerVersion the entries were last checked on. On any other build the load warns that vtable indices and offsets are unchecked."
        },
        "verified": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date the whole file was last walked entry by entry (YYYY-MM-DD)."
        }
      }
    },
    "functions": {
      "type": "object",
      "description": "Functions found by a byte pattern; the match address is the binding.",
      "additionalProperties": { "$ref": "#/definitions/function" }
    },
    "globals": {
      "type": "object",
      "description": "Globals reached through a rel32 displacement inside a pattern's match.",
      "additionalProperties": { "$ref": "#/definitions/global" }
    },
    "vtables": {
      "type": "object",
      "description": "Virtual function slots, with the class whose primary table the index is counted in.",
      "additionalProperties": { "$ref": "#/definitions/vtable" }
    },
    "offsets": {
      "type": "object",
      "description": "Byte offsets into layouts the SDK headers do not declare.",
      "additionalProperties": { "$ref": "#/definitions/offset" }
    }
  },
  "definitions": {
    "module": {
      "type": "string",
      "default": "server",
      "description": "Module to look in, without platform prefix/suffix (\"server\" -> server.dll / libserver.so)."
    },
    "pattern": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}|\\?\\??)( ([0-9A-Fa-f]{2}|\\?\\??))*$",
      "description": "Space-separated hex bytes; \"?\" or \"??\" is a wildcard byte."
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
      "properties": {
        "module": { "$ref": "#/definitions/module" },
        "windows": { "$ref": "#/definitions/pattern" },
        "linux": { "$ref": "#/definitions/pattern" }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
      "properties": {
        "module": { "$ref": "#/definitions/module" },
        "windows": { "$ref": "#/definitions/globalColumn" },
        "linux": { "$ref": "#/definitions/globalColumn" }
      }
    },
    "globalColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "rel32At"],
      "properties": {
        "pattern": { "$ref": "#/definitions/pattern" },
        "rel32At": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte distance from the match to the 4-byte little-endian rel32 displacement."
        }
      }
    },
    "vtable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
      "properties": {
        "class": { "$ref": "#/definitions/class" },
        "base": {
          "$ref": "#/definitions/class",
          "description": "Count the index in this base's own vtable inside `class`, found through RTTI."
        },
        "module": { "$ref": "#/definitions/module" },
        "windows": { "type": "integer", "minimum": 0 },
        "linux": { "type": "integer", "minimum": 0 }
      }
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "A byte offset per platform.",
          "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
          "not": { "anyOf": [{ "required": ["class"] }, { "required": ["base"] }, { "required": ["module"] }] }
        },
        {
          "description": "Where `base` sits inside `class`, read from RTTI at load.",
          "required": ["class", "base"],
          "not": { "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }] }
        }
      ],
      "properties": {
        "windows": { "type": "integer", "minimum": 0 },
        "linux": { "type": "integer", "minimum": 0 },
        "class": { "$ref": "#/definitions/class" },
        "base": { "$ref": "#/definitions/class" },
        "module": { "$ref": "#/definitions/module" }
      }
    },
    "class": {
      "type": "string",
      "description": "Top-level RTTI class name (no namespace, no template); a class or a struct."
    }
  }
}
