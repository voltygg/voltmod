{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "voltmod gamedata.jsonc",
  "description": "Engine locations for the ABIs declared in VoltMod::Bindings. Re-verify after every CS2 update.",
  "type": "object",
  "additionalProperties": false,
  "required": ["build"],
  "properties": {
    "$schema": { "type": "string" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "verified"],
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "steam.inf ServerVersion used for the last check. Other builds warn that vtable indices and offsets are unchecked."
        },
        "verified": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of the last full file check (YYYY-MM-DD)."
        }
      }
    },
    "functions": {
      "type": "object",
      "description": "Functions located by byte pattern, or by the VScript binding that calls them.",
      "additionalProperties": { "$ref": "#/definitions/function" }
    },
    "globals": {
      "type": "object",
      "description": "Globals reached through a rel32 displacement in a pattern match.",
      "additionalProperties": { "$ref": "#/definitions/global" }
    },
    "vtables": {
      "type": "object",
      "description": "Virtual function slots and the class table that supplies each index.",
      "additionalProperties": { "$ref": "#/definitions/vtable" }
    },
    "offsets": {
      "type": "object",
      "description": "Byte offsets for fields absent from the SDK headers.",
      "additionalProperties": { "$ref": "#/definitions/offset" }
    }
  },
  "definitions": {
    "module": {
      "type": "string",
      "default": "server",
      "description": "Module to search, without platform prefix or suffix (\"server\" -> server.dll / libserver.so)."
    },
    "pattern": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}|\\?\\??)( ([0-9A-Fa-f]{2}|\\?\\??))*$",
      "description": "Space-separated hexadecimal bytes; \"?\" and \"??\" are wildcard bytes."
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "Byte pattern for each platform.",
          "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
          "not": { "anyOf": [{ "required": ["class"] }, { "required": ["script"] }] }
        },
        {
          "description": "The function a VScript binding of `class` calls, found by name at load.",
          "required": ["class", "script"],
          "not": { "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }] }
        }
      ],
      "properties": {
        "module": { "$ref": "#/definitions/module" },
        "windows": { "$ref": "#/definitions/pattern" },
        "linux": { "$ref": "#/definitions/pattern" },
        "class": { "$ref": "#/definitions/class" },
        "script": { "$ref": "#/definitions/script" }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
      "properties": {
        "module": { "$ref": "#/definitions/module" },
        "windows": { "$ref": "#/definitions/globalColumn" },
        "linux": { "$ref": "#/definitions/globalColumn" }
      }
    },
    "globalColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "rel32At"],
      "properties": {
        "pattern": { "$ref": "#/definitions/pattern" },
        "rel32At": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte distance from the match to the 4-byte little-endian rel32 displacement."
        }
      }
    },
    "vtable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "oneOf": [
        {
          "description": "Index for each platform.",
          "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
          "not": { "required": ["script"] }
        },
        {
          "description": "The index a virtual VScript binding of `class` dispatches through, read at load.",
          "required": ["script"],
          "not": { "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }, { "required": ["base"] }] }
        }
      ],
      "properties": {
        "class": { "$ref": "#/definitions/class" },
        "base": {
          "$ref": "#/definitions/class",
          "description": "Count the index in `base`'s vtable inside `class`, found through RTTI."
        },
        "module": { "$ref": "#/definitions/module" },
        "windows": { "type": "integer", "minimum": 0 },
        "linux": { "type": "integer", "minimum": 0 },
        "script": { "$ref": "#/definitions/script" }
      }
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "Byte offset for each platform.",
          "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }],
          "not": { "anyOf": [{ "required": ["class"] }, { "required": ["base"] }, { "required": ["module"] }] }
        },
        {
          "description": "Location of `base` inside `class`, read from RTTI at load.",
          "required": ["class", "base"],
          "not": { "anyOf": [{ "required": ["windows"] }, { "required": ["linux"] }] }
        }
      ],
      "properties": {
        "windows": { "type": "integer", "minimum": 0 },
        "linux": { "type": "integer", "minimum": 0 },
        "class": { "$ref": "#/definitions/class" },
        "base": { "$ref": "#/definitions/class" },
        "module": { "$ref": "#/definitions/module" }
      }
    },
    "class": {
      "type": "string",
      "description": "Top-level RTTI class name without a namespace or template."
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "description": "A VScript binding name, searched in the class's script description and then its bases."
    }
  }
}
