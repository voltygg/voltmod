{
  "$schema": "./gamedata.schema.json",

  // Entries drift with CS2. `server` is the checked steam.inf ServerVersion and `verified` is the
  // check date. See docs/sdk/gamedata.md.
  "build": {
    "server": "2000908",
    "verified": "2026-09-11"
  },

  // Byte patterns match function starts in a loaded module; `?` and `??` are wildcards.
  "functions": {
    // CCSCustomHudLayout setters. Server-only hash indexes shadow their tables, so call these
    // setters directly. See docs/custom-ui.md. Windows patterns are from server.dll build 24934554
    // and match once in .text; Linux patterns are from SwiftlyS2.
    "CCSCustomHudLayout::SetHasClass": {
      "module": "server",
      "windows": "48 89 5C 24 08 48 89 6C 24 10 48 89 74 24 18 57 48 83 EC 30 49 8B F0 33 ED 4C 8D 44 24 24 66 89 6C 24 24 41 8B F9 48 8B D9 E8 ? ? ? ? 84 C0 74 33",
      "linux": "55 48 89 E5 41 57 41 56 41 55 41 89 CD 41 54 49 89 D4 31 D2"
    },

    // Same body as SetDialogVariableForPlayer, with a `44 8B` / `45 89 C6` tail. Keep both tails.
    "CCSCustomHudLayout::SetHasClassForPlayer": {
      "module": "server",
      "windows": "40 53 56 57 48 83 EC 20 48 63 DA 49 8B F1 49 8B C0 48 8B F9 3B 99 ? ? ? ? 7D 5E 48 89 6C 24 50 4C 8D 44 24 40 33 ED 48 8B D0 66 89 6C 24 40 E8 ? ? ? ? 84 C0 74 3C 4C 8D 44 24 48 66 89 6C 24 48 48 8B D6 48 8B CF E8 ? ? ? ? 84 C0 74 23 44 8B",
      "linux": "55 48 89 E5 41 56 41 55 41 54 41 89 F4 53 48 83 EC ? 3B B7 ? ? ? ? 7C ? 48 83 C4 ? 5B 41 5C 41 5D 41 5E 5D C3 66 0F 1F 84 00 ? ? ? ? 48 89 D6 31 D2 48 89 FB 66 89 55 ? 48 8D 55 ? 49 89 CD 45 89 C6"
    },

    "CCSCustomHudLayout::SetDialogVariableString": {
      "module": "server",
      "windows": "48 89 5C 24 08 48 89 6C 24 10 48 89 74 24 18 57 48 83 EC 30 49 8B F0 33 ED 4C 8D 44 24 24 66 89 6C 24 24 49 8B F9 48 8B D9 E8 ? ? ? ? 84 C0 74 33",
      "linux": "55 48 89 E5 41 55 49 89 CD 41 54 49 89 D4 31 D2"
    },

    // Twin of SetHasClassForPlayer, with a `4C 8B` / `4D 89 C6` tail.
    "CCSCustomHudLayout::SetDialogVariableStringForPlayer": {
      "module": "server",
      "windows": "40 53 56 57 48 83 EC 20 48 63 DA 49 8B F1 49 8B C0 48 8B F9 3B 99 ? ? ? ? 7D 5E 48 89 6C 24 50 4C 8D 44 24 40 33 ED 48 8B D0 66 89 6C 24 40 E8 ? ? ? ? 84 C0 74 3C 4C 8D 44 24 48 66 89 6C 24 48 48 8B D6 48 8B CF E8 ? ? ? ? 84 C0 74 23 4C 8B",
      "linux": "55 48 89 E5 41 56 41 55 41 54 41 89 F4 53 48 83 EC ? 3B B7 ? ? ? ? 7C ? 48 83 C4 ? 5B 41 5C 41 5D 41 5E 5D C3 66 0F 1F 84 00 ? ? ? ? 48 89 D6 31 D2 48 89 FB 66 89 55 ? 48 8D 55 ? 49 89 CD 4D 89 C6"
    },

    // Linux starts at the slot comparison and sets up a frame after the range check.
    "CCSCustomHudLayout::SetInputCaptureEnabled": {
      "module": "server",
      "windows": "40 57 48 83 EC 20 41 0F B6 F8 3B 91 ? ? ? ? 7D 39",
      "linux": "3B B7 ? ? ? ? 0F 8D ? ? ? ? 55"
    },

    // String: "Sending S2C_CONNECTION to %s [addons:'%s']".
    // From MultiAddonManager; Windows checked on build 2000908.
    "CNetworkGameServer::ReplyConnection": {
      "module": "engine2",
      "windows": "48 8B C4 55 41 55 41 56",
      "linux": "55 B9 ? ? ? ? 41 B8"
    },

    "GetLegacyGameEventListener": {
      "module": "server",
      "windows": "48 8B 15 ? ? ? ? 48 85 D2 74 ? 85 C9",
      "linux": "48 8B 05 ? ? ? ? 48 85 C0 74 ? 83 FF ? 77 ? 48 63 FF 48 C1 E7 ? 48 8D 44 38"
    },

    // These patterns come from CS2Fixes gamedata (github.com/Source2ZE/CS2Fixes). Re-sync them
    // after a CS2 update.
    "CreateEntityByName": {
      "module": "server",
      "windows": "48 83 EC 48 C6 44 24 30 00",
      "linux": "48 8D 05 ? ? ? ? 55 48 89 FA"
    },

    "DispatchSpawn": {
      "module": "server",
      "windows": "48 89 5C 24 10 57 48 83 EC 30 48 8B DA 48 8B F9 48 85 C9",
      "linux": "48 85 FF 74 ? 55 48 89 E5 41 55 41 54 49 89 FC"
    },

    // Not a vtable call in CS2.
    "CEntityInstance::AcceptInput": {
      "module": "server",
      "windows": "48 89 5C 24 ? 48 89 74 24 ? 57 48 83 EC ? 49 8B F0 48 8B D9 48 8B 0D",
      "linux": "55 48 89 E5 41 56 49 89 FE 41 55 48 8D 7D"
    },

    // Deferred entity IO, including delayed inputs and "Kill" cleanup.
    "CEntitySystem::AddEntityIOEvent": {
      "module": "server",
      "windows": "48 89 5C 24 18 4C 89 4C 24 20 48 89 4C 24 08 55 56 57 41 54 41 55 41 56 41 57 48 83 EC 20",
      "linux": "55 48 89 E5 41 55 49 89 CD 41 54 49 89 FC 53 BB"
    },

    // Remove immediately instead of using the IO queue above.
    "UTIL_Remove": {
      "module": "server",
      "windows": "48 85 C9 74 ? 48 8B D1 48 8B 0D ? ? ? ?",
      "linux": "48 89 FE 48 85 FF 74 ? 48 8D 05 ? ? ? ? 48"
    },

    // Vscript binding that can disappear between builds. EmitSoundFilter is more stable.
    "CBaseEntity::EmitSoundParams": {
      "module": "server",
      "windows": "48 89 5C 24 ? 48 89 74 24 ? 48 89 7C 24 ? 55 48 8B EC 48 81 EC ? ? ? ? 33 C0",
      "linux": "48 B8 ? ? ? ? ? ? ? ? 55 0F 28 D0"
    },

    // Returns StartSoundEventInfo.
    "CBaseEntity::EmitSoundFilter": {
      "module": "server",
      "windows": "40 53 48 83 EC ? 4C 89 4C 24 ? 48 8B D9 45 8B C8",
      "linux": "55 48 89 E5 53 48 89 FB 48 83 EC ? E8 ? ? ? ? 48 89 D8 48 8B 5D ? C9 C3 CC CC CC CC CC CC 48 B8"
    },

    "CBaseModelEntity::SetModel": {
      "module": "server",
      "windows": "40 53 48 83 EC ? 48 8B D9 4C 8B C2 48 8B 0D ? ? ? ? 48 8D 54 24 ? 48 8B 01 FF 50 ? 48 8B 54 24 ? 48 8B CB E8 ? ? ? ? 48 83 C4 ? 5B C3 CC CC CC CC CC CC CC CC CC CC CC CC CC CC CC 48 89 5C 24",
      "linux": "55 48 89 E5 53 48 89 FB 48 83 EC ? 48 8D 05 ? ? ? ? 48 8B 38 48 8B 07 FF 50 ? 48 89 DF 48 8B 5D ? C9 48 89 C6 E9 ? ? ? ? CC CC CC CC 55"
    },

    // String: "CBaseEntity::TakeDamageOld". Every entity's damage passes through here. From CS2Fixes.
    "CBaseEntity::TakeDamageOld": {
      "module": "server",
      "windows": "40 55 53 56 57 41 54 48 8D 6C 24 ? 48 81 EC ? ? ? ? 4D 8B E0",
      "linux": "55 66 0F EF C0 48 89 E5 41 57 41 56 41 55 49 89 FD 31 FF"
    },

    // From CS2Fixes.
    "CTakeDamageInfo::CTakeDamageInfo": {
      "module": "server",
      "windows": "48 89 5C 24 ? 48 89 6C 24 ? 48 89 74 24 ? 48 89 7C 24 ? 41 56 48 83 EC ? 45 33 F6 48 C7 41",
      "linux": "49 BB ? ? ? ? ? ? ? ? 55 48 89 E5 48 83 EC ? 4C 8D 15"
    },

    // Ends the round with a reason and a restart delay. From CS2Fixes; SwiftlyS2 has the same bytes.
    "CCSGameRules::TerminateRound": {
      "module": "server",
      "windows": "48 8B C4 4C 89 48 ? 48 89 48 ? 55 41 54",
      "linux": "55 48 89 E5 41 57 41 56 41 55 41 54 41 89 F4 53 48 8D 35 ? ? ? ? 48 89 FB"
    },

    "CGameEntitySystem::FindEntityByClassName": {
      "module": "server",
      "windows": "48 83 EC 68 45 33 C9",
      "linux": "55 45 31 C0 31 C9 48 89 E5 53 48 8D 5D ? 48 83 EC ? 48 89 DF"
    },

    "CGameEntitySystem::FindEntityByName": {
      "module": "server",
      "windows": "48 81 EC 88 ? ? ? 4D 85 C0",
      "linux": "55 48 89 E5 41 54 53 48 83 EC ? 48 85 D2"
    }
  },

  // Globals use a pattern that references them through rel32. `rel32At` gives the byte distance
  // from the match to the 4-byte little-endian displacement.
  "globals": {
    // IGameEventManager2** in CSource2Server::Init, matched by "gameeventmanager->Init()". From
    // s2sdk.
    "CSource2Server::g_GameEventManager": {
      "module": "server",
      "windows": {
        "pattern": "48 83 EC ? 48 83 3D ? ? ? ? ? 74 ? 33 C9 E8 ? ? ? ? FF 15 ? ? ? ?",
        "rel32At": 98
      },
      "linux": {
        "pattern": "55 48 89 E5 41 55 41 54 53 48 83 EC 08 48 8D 05 ? ? ? ? 48 83 38 00",
        "rel32At": 106
      }
    },

    // IGameSystem::InitAllSystems, matched by "Game System %s is defined twice!". From CS2Fixes.
    "CBaseGameSystemFactory::sm_pFirst": {
      "module": "server",
      "windows": { "pattern": "48 8B 1D ? ? ? ? 48 85 DB 0F 84 ? ? ? ? BD", "rel32At": 3 },
      "linux": { "pattern": "4C 8B 35 ? ? ? ? 4D 85 F6 75 ? E9", "rel32At": 3 }
    },

    // IGameSystem::LoopPostInitAllSystems. Detached on unload. From CS2Fixes.
    "IGameSystem::pEventDispatcher": {
      "module": "server",
      "windows": { "pattern": "48 39 1D ? ? ? ? 74 ? 39 05", "rel32At": 3 },
      "linux": { "pattern": "4C 8B 25 ? ? ? ? 48 8B 05 ? ? ? ? 8B 35", "rel32At": 3 }
    },

    // CUtlVector<AddedGameSystem_t> used by IGameSystem::LoopDestroyAllSystems; the framework
    // removes its entry on unload. From CS2Fixes.
    "IGameSystem::s_GameSystems": {
      "module": "server",
      "windows": { "pattern": "8B 05 ? ? ? ? 83 E8 ? 48 63 F8 0F 88", "rel32At": 2 },
      "linux": { "pattern": "8B 05 ? ? ? ? 89 C2 83 EA ? 0F 88 ? ? ? ? 4C 8D 3D", "rel32At": 2 }
    }
  },

  // Vtable slots. `class` owns the table and supplies the index origin. When present, `base` names
  // the base table inside `class` where the index is counted. A wrong index can crash.
  "vtables": {
    // The Nav_TraceLine overload taking a filter; the interface is stateless, so Trace calls it
    // on the class table. Windows read off the 2000908 vtable, linux inferred from the ABI.
    "CNavPhysicsInterface::Nav_TraceLine": {
      "class": "CNavPhysicsInterface",
      "windows": 1,
      "linux": 3
    },
    // The Nav_TraceShape overload taking a filter; Trace::Hull sweeps a box with it. Windows read
    // off the 2000908 vtable, linux inferred from the ABI. From CS2AC.
    "CNavPhysicsInterface::Nav_TraceShape": {
      "class": "CNavPhysicsInterface",
      "windows": 3,
      "linux": 5
    },
    // Called on a CCSPlayerPawn. From SwiftlyS2 v1.4.5.
    "CBasePlayerPawn::CommitSuicide": { "class": "CCSPlayerPawn", "windows": 384, "linux": 384 },
    // From SwiftlyS2.
    "CCSPlayerController::ChangeTeam": {
      "class": "CCSPlayerController",
      "windows": 103,
      "linux": 102
    },
    // From SwiftlyS2 v1.4.5.
    "CCSPlayerController::Respawn": { "class": "CCSPlayerController", "windows": 270, "linux": 272 },
    // Hooks::Teleport hooks this on the pawn class; Entity::Teleport calls it directly. From
    // SwiftlyS2.
    "CBaseEntity::Teleport": { "class": "CCSPlayerPawn", "windows": 163, "linux": 162 },
    // Hooks::Movement targets the concrete movement-services class instantiated by each pawn. From
    // SwiftlyS2 v1.4.5.
    "CPlayer_MovementServices::RunCommand": {
      "class": "CCSPlayer_MovementServices",
      "windows": 25,
      "linux": 26
    },
    // Called on the pawn's m_pItemServices. From SwiftlyS2 / s2sdk.
    "CCSPlayer_ItemServices::GiveNamedItem": {
      "class": "CCSPlayer_ItemServices",
      "windows": 23,
      "linux": 24
    },
    // From SwiftlyS2 / s2sdk.
    "CCSPlayer_ItemServices::RemoveAllItems": {
      "class": "CCSPlayer_ItemServices",
      "windows": 27,
      "linux": 28
    },
    // From CS2AC.
    "CServerSideClient::ProcessRespondCvarValue": {
      "class": "CServerSideClient",
      "module": "engine2",
      "windows": 38,
      "linux": 40
    },
    // In the primary vtable. From SwiftlyS2.
    "CServerSideClient::SendNetMessage": {
      "class": "CServerSideClient",
      "module": "engine2",
      "windows": 15,
      "linux": 16
    },
    // The interface's only virtual, so slot 0 in the base table. The hook receives the base.
    // Windows checked on build 2000908.
    "INetworkMessageProcessingPreFilter::FilterMessage": {
      "class": "CServerSideClient",
      "base": "INetworkMessageProcessingPreFilter",
      "module": "engine2",
      "windows": 0,
      "linux": 0
    }
  },

  // Byte offsets for layout fields absent from the SDK. A stale offset reads plausible garbage.
  "offsets": {
    // CGameEntitySystem* cached inside IGameResourceService.
    "GameEntitySystem": { "windows": 88, "linux": 80 },

    // Recipient slot in CCheckTransmitInfo. The SDK declares only its two leading bitvec pointers;
    // read this field as one byte. From CS2Fixes gamedata.
    "CheckTransmitPlayerSlot": { "windows": 576, "linux": 576 },

    // The protobuf base of CUserCmd. Checked against CS2Fixes and SwiftlyS2.
    "CUserCmd::CSGOUserCmdPB": { "windows": 16, "linux": 16 },
    // Native counter in CUserCmd. The live client leaves CBaseUserCmdPB.legacy_command_number
    // empty. From CS2AC.
    "CUserCmdBase::cmdNum": { "windows": 8, "linux": 8 },

    // From CS2AC (ClientSlotOffset).
    "CServerSideClientBase::m_nClientSlot": { "windows": 72, "linux": 72 },

    // Follows bools and is unaligned, so read it with memcpy.
    // Addons key on it because reconnects can change a client's slot but not its SteamID. From
    // SwiftlyS2 v1.4.5.
    "CServerSideClientBase::m_SteamID": { "windows": 171, "linux": 171 },

    // From MultiAddonManager; Windows checked on build 2000908.
    "CNetworkGameServer::m_szAddons": { "windows": 344, "linux": 344 },

    // A base, not a field: FilterMessage's `this`, read from RTTI. 8 on Windows build 2000908, 48 on Linux.
    "CServerSideClient::INetworkMessageProcessingPreFilter": {
      "class": "CServerSideClient",
      "base": "INetworkMessageProcessingPreFilter",
      "module": "engine2"
    }
  }
}
