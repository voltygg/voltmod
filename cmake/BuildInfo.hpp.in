#pragma once

// Generated at build time - do not edit. Include only from your plugin's
// Plugin.cpp: the values change every commit.

namespace VoltMod::BuildInfo
{

/// "<version.txt>+<short-sha>[-dirty]", e.g. "1.2.0+a1b2c3d". A modified tree shows up as
/// `-dirty`, so one string identifies the build.
inline constexpr const char* Version = "@VOLTMOD_BI_VERSION@";
inline constexpr const char* RepoCommit = "@VOLTMOD_BI_REPO_COMMIT@";
/// ISO-8601 last-commit date (not wall clock, so no-op builds stay no-op).
inline constexpr const char* BuildDate = "@VOLTMOD_BI_DATE@";

}  // namespace VoltMod::BuildInfo
