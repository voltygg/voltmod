              </Panel>
            </Panel>
            <Label class="Row-label" text="{s:vm_row1_label}" />
            <Label class="Row-value" text="{s:vm_row1_value}" />
          </Button>
          <Panel class="Steps" hittest="true">
            <Button id="vm_row1_dec" class="Stepper">
              <Label text="&#9664;" />
            </Button>
            <Button id="vm_row1_inc" class="Stepper">
              <Label text="&#9654;" />
            </Button>
          </Panel>
        </Panel>
        <Panel id="vm_row2" class="Row Hidden" hittest="true">
          <Panel class="Mark" hittest="false" />
          <Button id="vm_row2_btn" class="Row-btn">
            <Panel class="Glyphs" hittest="false">
