<root>
  <!--
    Driven by VoltMod::MenuManager's Panorama driver. The ids are the contract
    (docs/custom-ui.md); everything else is yours. Text is dialog variables on vm_root, which the
    labels inherit.

    Clickability: every panel on the click path has a resolved size, a Button never contains
    another Button, and decorative panels are hittest="false". Eight rows, matching the driver's
    page size; the server cannot read this file.
  -->
  <styles>
    <include src="file://{resources}/styles/custom_game/voltmod_menu.css" />
  </styles>

  <Panel class="Root" hittest="false">
    <Panel id="vm_root" class="Menu Hidden" hittest="true">
      <Panel class="Header" hittest="false">
        <Label class="Title" text="{s:vm_title}" />
        <Label id="vm_subtitle" class="Subtitle" text="{s:vm_subtitle}" />
      </Panel>

      <Panel class="Rows" hittest="true">
        <Panel id="vm_row0" class="Row Hidden" hittest="true">
          <Button id="vm_row0_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row0_label}" />
            <Label class="Row-value" text="{s:vm_row0_value}" />
          </Button>
          <Button id="vm_row0_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row0_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
        <Panel id="vm_row1" class="Row Hidden" hittest="true">
          <Button id="vm_row1_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row1_label}" />
            <Label class="Row-value" text="{s:vm_row1_value}" />
          </Button>
          <Button id="vm_row1_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row1_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
        <Panel id="vm_row2" class="Row Hidden" hittest="true">
          <Button id="vm_row2_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row2_label}" />
            <Label class="Row-value" text="{s:vm_row2_value}" />
          </Button>
          <Button id="vm_row2_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row2_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
        <Panel id="vm_row3" class="Row Hidden" hittest="true">
          <Button id="vm_row3_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row3_label}" />
            <Label class="Row-value" text="{s:vm_row3_value}" />
          </Button>
          <Button id="vm_row3_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row3_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
        <Panel id="vm_row4" class="Row Hidden" hittest="true">
          <Button id="vm_row4_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row4_label}" />
            <Label class="Row-value" text="{s:vm_row4_value}" />
          </Button>
          <Button id="vm_row4_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row4_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
        <Panel id="vm_row5" class="Row Hidden" hittest="true">
          <Button id="vm_row5_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row5_label}" />
            <Label class="Row-value" text="{s:vm_row5_value}" />
          </Button>
          <Button id="vm_row5_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row5_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
        <Panel id="vm_row6" class="Row Hidden" hittest="true">
          <Button id="vm_row6_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row6_label}" />
            <Label class="Row-value" text="{s:vm_row6_value}" />
          </Button>
          <Button id="vm_row6_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row6_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
        <Panel id="vm_row7" class="Row Hidden" hittest="true">
          <Button id="vm_row7_btn" class="Row-btn">
            <Label class="Row-label" text="{s:vm_row7_label}" />
            <Label class="Row-value" text="{s:vm_row7_value}" />
          </Button>
          <Button id="vm_row7_dec" class="Stepper"><Label text="&#9664;" /></Button>
          <Button id="vm_row7_inc" class="Stepper"><Label text="&#9654;" /></Button>
        </Panel>
      </Panel>

      <Panel id="vm_pager" class="Pager Hidden" hittest="true">
        <Button id="vm_prev" class="Arrow"><Label text="&#9664;" /></Button>
        <Label class="Pager-label" text="{s:vm_page}" />
        <Button id="vm_next" class="Arrow"><Label text="&#9654;" /></Button>
      </Panel>

      <Panel class="Footer" hittest="true">
        <Button id="vm_back" class="Nav Hidden"><Label text="Back" /></Button>
        <Button id="vm_close" class="Nav"><Label text="Close" /></Button>
      </Panel>

      <!-- Shown while a chat-input prompt is open; the driver ignores row presses meanwhile. -->
      <Panel id="vm_prompt" class="Prompt Hidden" hittest="true">
        <Label class="Prompt-text" text="{s:vm_prompt_text}" />
        <Button id="vm_cancel" class="Nav"><Label text="Cancel" /></Button>
      </Panel>
    </Panel>
  </Panel>
</root>
