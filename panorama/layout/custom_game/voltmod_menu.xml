<root>
  <!--
    Driven by VoltMod::MenuManager's Panorama driver. The ids below are the contract
    (docs/custom-ui.md); the nesting, the artwork and the animation are ours. All text is dialog
    variables on vm_root, which the labels inherit: vm_title, vm_breadcrumb, vm_subtitle, vm_page,
    vm_prompt_text, vm_prompt_hint and the per-row vm_row{i}_label / vm_row{i}_value.

    Clickability (each of these fails silently): every panel on the click path has a resolved
    size, a Button never contains another Button, and decorative panels are hittest="false".
    Eight rows, matching the driver's page size; the server cannot read this file.

    Each row carries its own kind glyph set. Exactly one is uncollapsed by the row's kind class
    (Kind, two dashes, then button, text, submenu, toggle, choice or input - spelled out here
    because XML forbids a double dash inside a comment), and they stack on one 26px column so a
    row without a glyph still lines up.
  -->
  <styles>
    <include src="file://{resources}/styles/custom_game/voltmod_menu.css" />
  </styles>

  <Panel class="Root" hittest="false">
    <Panel id="vm_root" class="Menu Hidden" hittest="true">
      <Panel class="Header" hittest="false">
        <Label class="Breadcrumb" text="{s:vm_breadcrumb}" />
        <Label class="Title" text="{s:vm_title}" />
        <Label id="vm_subtitle" class="Subtitle" text="{s:vm_subtitle}" />
      </Panel>
      <Panel class="Rule" hittest="false" />

      <Panel class="Rows" hittest="true">
        <Panel id="vm_row0" class="Row Hidden" hittest="true">
          <Panel class="Mark" hittest="false" />
          <Button id="vm_row0_btn" class="Row-btn">
            <Panel class="Glyphs" hittest="false">
              <Label class="Glyph G--submenu" text="&#9654;" />
              <Label class="Glyph G--input" text="&#8230;" />
              <Label class="Glyph G--button" text="&#8226;" />
              <Label class="Glyph G--text" text="&#8211;" />
              <Panel class="Switch" hittest="false">
                <Panel class="Switch-knob" hittest="false" />
              </Panel>
            </Panel>
            <Label class="Row-label" text="{s:vm_row0_label}" />
            <Label class="Row-value" text="{s:vm_row0_value}" />
          </Button>
          <Panel class="Steps" hittest="true">
            <Button id="vm_row0_dec" class="Stepper">
              <Label text="&#9664;" />
            </Button>
            <Button id="vm_row0_inc" class="Stepper">
              <Label text="&#9654;" />
            </Button>
          </Panel>
        </Panel>
        <Panel id="vm_row1" class="Row Hidden" hittest="true">
          <Panel class="Mark" hittest="false" />
          <Button id="vm_row1_btn" class="Row-btn">
