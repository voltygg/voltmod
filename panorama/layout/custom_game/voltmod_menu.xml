      </Panel>

      <Panel id="vm_pager" class="Pager Hidden" hittest="true">
        <Button id="vm_prev" class="Arrow">
          <Label text="&#9664;" />
        </Button>
        <Label class="Pager-label" text="{s:vm_page}" />
        <Button id="vm_next" class="Arrow">
          <Label text="&#9654;" />
        </Button>
      </Panel>

      <!-- Shown while a chat-input prompt is open; the driver ignores row presses meanwhile. -->
      <Panel id="vm_prompt" class="Prompt Hidden" hittest="true">
        <Label class="Prompt-text" text="{s:vm_prompt_text}" />
        <Label class="Prompt-hint" text="{s:vm_prompt_hint}" />
        <Button id="vm_cancel" class="Nav Nav--narrow">
          <Label text="Cancel" />
        </Button>
      </Panel>

      <!-- Back and Close are always laid out; at the root, Back is drawn inert instead of hidden.
           The hint line keeps its box and fades, so showing it never reflows the footer. -->
      <Panel class="Foot" hittest="true">
        <Panel class="Nav-row" hittest="true">
          <Button id="vm_back" class="Nav">
            <Label text="Back" />
          </Button>
          <Button id="vm_close" class="Nav">
            <Label text="Close" />
          </Button>
        </Panel>
        <Label class="Hints" text="[W/S] Navigate &#183; [A/D] Change &#183; [E] Select &#183; [R] Back" />
      </Panel>
