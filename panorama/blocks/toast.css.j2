.Toast {
  width: 260px;
  height: fit-children;
  flow-children: right;
  padding: 6px 10px;
  background-color: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(200, 162, 74, 0.45);
  visibility: collapse;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.12s;
}

.Toast.Show {
  visibility: visible;
  opacity: 1;
}

.Toast-body {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
}

.Toast-title {
  width: 100%;
  font-size: 14px;
  font-weight: bold;
  color: #e8e6e0;
}

.Toast-text {
  width: 100%;
  font-size: 12px;
  color: #8a8778;
}
