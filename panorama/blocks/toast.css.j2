.toast {
  width: 260px;
  height: fit-children;
  flow-children: right;
  padding: 6px 10px;
  background-color: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(200, 162, 74, 0.45);
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.12s;
}

.toast.hidden {
  opacity: 0;
}

.toast__body {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
}

.toast__title {
  width: 100%;
  font-size: 14px;
  font-weight: bold;
  color: #e8e6e0;
}

.toast__text {
  width: 100%;
  font-size: 12px;
  color: #8a8778;
}
