{#- A strip of `count` tabs. Each reads `{s:<id><i>}` and starts hidden, so a driver shows only
    the ones it has a label for and puts `tab--selected` on the open one. -#}
{% macro tabs(id, count) -%}
<Panel class="tabs" hittest="true">
  {%- for index in range(count) %}
  <Button id="{{screen}}_{{id}}{{index}}" class="tab hidden">
    <Label class="tab__label" text="{s:{{id}}{{index}}}" hittest="false" />
  </Button>
  {%- endfor %}
</Panel>
{%- endmacro %}
