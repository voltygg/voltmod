{#- A row of `count` tabs, each showing `{s:<id><i>}`. They start hidden; C++ shows the ones it
    uses and adds `tab--selected` to the open one. -#}
{% macro tabs(id, count) -%}
<Panel class="tabs" hittest="true">
  {%- for index in range(count) %}
  <Button id="{{screen}}_{{id}}{{index}}" class="tab hidden">
    <Label class="tab__label" text="{s:{{id}}{{index}}}" hittest="false" />
  </Button>
  {%- endfor %}
</Panel>
{%- endmacro %}
