{#- A bar's layout plus one width rule per step, from `bar--step-0` (empty) to `bar--step-<steps>`
    (full). Each screen picks its own number of steps. -#}
{% macro styles(steps) %}
.bar {
  width: 120px;
  height: 6px;
  background-color: rgba(255, 255, 255, 0.05);
}

.bar__fill {
  height: 100%;
  background-color: #c8a24a;
}
{% for step in range(steps + 1) %}
.bar.bar--step-{{step}} .bar__fill {
  width: {{ (step * 100 / steps) | round(1) }}%;
}
{% endfor %}
{%- endmacro %}
