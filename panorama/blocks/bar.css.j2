.bar {
  width: 120px;
  height: 6px;
  background-color: rgba(255, 255, 255, 0.05);
}

.bar.hidden {
  visibility: collapse;
}

.bar__fill {
  height: 100%;
  background-color: #c8a24a;
}

{#- The step count is per bar rather than per stylesheet, so the widths are emitted per bar.
    `cls` is the bar's own class, `bar` unless the screen renames it. -#}
{% macro fill_rules(cls, steps) %}
{% for step in range(steps + 1) %}
.{{cls}}.bar--step-{{step}} .bar__fill {
  width: {{ (step * 100 / steps) | round(1) }}%;
}
{% endfor %}
{%- endmacro %}
