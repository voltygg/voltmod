{% import "bar.xml.j2" as bars %}
{% import "icons.xml.j2" as icons %}

{#- A list row with an optional icon and bar. It starts hidden, so a card the plugin never fills in
    stays invisible. Element ids include the screen name; text variable names don't. -#}
{% macro card(id, icon_set=none, bar=false) -%}
<Panel id="{{screen}}_{{id}}" class="card hidden" hittest="false">
  <Panel class="card__main" hittest="false">
    {%- if icon_set %}
    {{ icons.icons(id ~ "_icon", icon_set) | indent(4) }}
    {%- endif %}
    <Panel class="card__body" hittest="false">
      <Label class="card__title" text="{s:{{id}}_title}" hittest="false" />
      <Label class="card__subtitle" text="{s:{{id}}_subtitle}" hittest="false" />
    </Panel>
    <Label class="card__value" text="{s:{{id}}_value}" hittest="false" />
  </Panel>
  {%- if bar %}
  {{ bars.bar(id ~ "_bar") | indent(2) }}
  {%- endif %}
</Panel>
{%- endmacro %}
