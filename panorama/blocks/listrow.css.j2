/* Layout only. A screen sets height, colour and radius after including this. */
.row {
  width: 100%;
  flow-children: right;
}

.row.hidden {
  visibility: collapse;
}

.row__button {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: right;
  padding: 0px 12px;
}

/* Fit, not 100%: a full-height column starts its lines at the top instead of centring them. */
.row__body {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
  vertical-align: center;
}

.row__label {
  width: 100%;
  font-size: 14px;
  text-overflow: ellipsis;
}

.row__hint {
  width: 100%;
  font-size: 11px;
  text-overflow: ellipsis;
}

.row__value {
  vertical-align: center;
  margin-left: 8px;
  font-size: 13px;
  text-overflow: ellipsis;
}

.switch {
  width: 36px;
  height: 20px;
  vertical-align: center;
  margin-left: 10px;
  border-radius: 10px;
  visibility: collapse;
}

.switch__knob {
  width: 14px;
  height: 14px;
  margin-left: 3px;
  vertical-align: center;
  border-radius: 7px;
  transform: translateX(0px);
  transition-property: transform;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

.row__chevron {
  vertical-align: center;
  visibility: collapse;
}

.row__steppers {
  width: 52px;
  height: 100%;
  flow-children: right;
  visibility: collapse;
}

.row__stepper {
  width: 26px;
  height: 100%;
  font-size: 11px;
}

/* A Label in a Button sits top-left unless told otherwise. */
.row__stepper-glyph {
  horizontal-align: center;
  vertical-align: center;
}
