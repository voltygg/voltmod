/* Layout only. A screen sets height, colour and radius after including this. */
.Row {
  width: 100%;
  flow-children: right;
}

.Row.Hidden {
  visibility: collapse;
}

.Row-hit {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: right;
  padding: 0px 12px;
}

/* Fit, not 100%: a full-height column starts its lines at the top instead of centring them. */
.Row-body {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
  vertical-align: center;
}

.Row-label {
  width: 100%;
  font-size: 14px;
  text-overflow: ellipsis;
}

.Row-hint {
  width: 100%;
  font-size: 11px;
  text-overflow: ellipsis;
}

.Row-value {
  vertical-align: center;
  margin-left: 8px;
  font-size: 13px;
  text-overflow: ellipsis;
}

.Switch {
  width: 36px;
  height: 20px;
  vertical-align: center;
  margin-left: 10px;
  border-radius: 10px;
  visibility: collapse;
}

.Switch-knob {
  width: 14px;
  height: 14px;
  margin-left: 3px;
  vertical-align: center;
  border-radius: 7px;
  transform: translateX(0px);
  transition-property: transform;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

.Row-chevron {
  vertical-align: center;
  visibility: collapse;
}

.Steppers {
  width: 52px;
  height: 100%;
  flow-children: right;
  visibility: collapse;
}

.Stepper {
  width: 26px;
  height: 100%;
  font-size: 11px;
}

/* A Label in a Button sits top-left unless told otherwise. */
.Stepper-glyph {
  horizontal-align: center;
  vertical-align: center;
}
