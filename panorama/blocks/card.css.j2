.Card {
  width: 100%;
  height: 44px;
  flow-children: right;
  margin-bottom: 4px;
  background-color: rgba(255, 255, 255, 0.05);
}

.Card.Hidden {
  visibility: collapse;
}

.Card-body {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: down;
  padding: 4px 8px;
}

.Card-title {
  width: 100%;
  font-size: 15px;
  color: #e8e6e0;
  text-overflow: ellipsis;
}

.Card-subtitle {
  width: 100%;
  font-size: 12px;
  color: #8a8778;
  text-overflow: ellipsis;
}

.Card-value {
  width: 90px;
  vertical-align: center;
  text-align: right;
  font-size: 15px;
  color: #c8a24a;
}
