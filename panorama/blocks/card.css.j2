.Card {
  width: 100%;
  height: fit-children;
  flow-children: down;
  margin-bottom: 4px;
  background-color: rgba(255, 255, 255, 0.05);
}

.Card.Hidden {
  visibility: collapse;
}

/* Fixed height, so two lines always fit. */
.Card-main {
  width: 100%;
  height: 48px;
  flow-children: right;
}

/* An empty icon slot would still take its width; the driver writes HasIcon. */
.Card .Icons {
  visibility: collapse;
}

.Card.HasIcon .Icons {
  visibility: visible;
}

.Card-body {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
  vertical-align: center;
  padding: 0px 10px;
}

.Card-title {
  width: 100%;
  font-size: 15px;
  color: #e8e6e0;
  text-overflow: ellipsis;
}

.Card-subtitle {
  width: 100%;
  font-size: 12px;
  color: #8a8778;
  text-overflow: ellipsis;
}

.Card-value {
  width: 90px;
  vertical-align: center;
  text-align: right;
  font-size: 15px;
  color: #c8a24a;
}

.Card .Bar {
  width: 100%;
  height: 3px;
}
