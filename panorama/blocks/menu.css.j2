{#- Layout, and the show/hide rules for the classes PanoramaMenuLayout writes. Colour and state are
    the screen's. -#}
{% include "button.css.j2" %}
{% include "icons.css.j2" %}
{% include "listrow.css.j2" %}

.layer {
  width: 100%;
  height: 100%;
}

.screen {
  width: 100%;
  height: 100%;
}

.hidden {
  visibility: collapse;
}

.menu {
  width: 920px;
  height: 640px;
  horizontal-align: center;
  vertical-align: center;
  flow-children: right;
}

.menu__sidebar {
  width: 236px;
  height: 100%;
  flow-children: down;
  padding: 22px 14px;
}

/* A menu without tabs drops the sidebar and keeps the content width. */
.screen.screen--no-sidebar .menu__sidebar {
  visibility: collapse;
}

.screen.screen--no-sidebar .menu {
  width: 684px;
}

.menu__brand {
  width: 100%;
  height: fit-children;
  flow-children: down;
  margin: 0px 10px 24px 10px;
}

.menu__nav {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
}

.tab {
  width: 100%;
  height: 44px;
  margin-bottom: 4px;
  padding: 0px 12px;
  flow-children: right;
}

.tab .icon-set {
  width: 20px;
  height: 20px;
  vertical-align: center;
  margin-right: 12px;
}

.tab__label {
  width: fill-parent-flow(1);
  vertical-align: center;
  font-size: 15px;
  text-overflow: ellipsis;
}

.menu__content {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: down;
  padding: 22px 26px 20px 26px;
}

.menu__header {
  width: 100%;
  height: fit-children;
  flow-children: right;
  margin-bottom: 16px;
}

.menu__header-text {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
}

/* Fixed height: empty at the root, and CSS cannot test that. */
.menu__breadcrumb {
  width: 100%;
  height: 16px;
  font-size: 12px;
  text-overflow: ellipsis;
}

.menu__title {
  width: 100%;
  font-size: 24px;
  font-weight: bold;
  text-overflow: ellipsis;
}

.menu__subtitle {
  width: 100%;
  font-size: 13px;
  text-overflow: ellipsis;
}

.icon-button {
  width: 36px;
  height: 36px;
}

.icon-button__image {
  width: 14px;
  height: 14px;
  horizontal-align: center;
  vertical-align: center;
}

.menu__rows {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
}

/* The optional `home` markup takes the rows' place while the root menu shows. */
.menu__home {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
  visibility: collapse;
}

.screen.screen--home .menu__home {
  visibility: visible;
}

.screen.screen--home .menu__rows {
  visibility: collapse;
}

.row {
  height: 50px;
  margin-bottom: 6px;
}

.row__button {
  padding: 0px 16px 0px 18px;
}

.row__label {
  font-size: 15px;
}

.row__hint {
  visibility: collapse;
}

.row.row--pending .row__hint {
  visibility: visible;
}

.row__value {
  margin-left: 10px;
  padding: 4px 10px;
  visibility: collapse;
}

.row.row--value .row__value {
  visibility: visible;
}

/* The switch already says ON or OFF. */
.row.row--toggle .row__value {
  visibility: collapse;
}

.row__chevron {
  margin-left: 12px;
  font-size: 22px;
}

.row.row--chevron .row__chevron {
  visibility: visible;
}

.switch {
  width: 44px;
  height: 24px;
  margin-left: 12px;
}

.row.row--toggle .switch {
  visibility: visible;
}

.switch__knob {
  width: 18px;
  height: 18px;
}

.row.row--on .switch__knob {
  transform: translateX(20px);
}

.row__steppers {
  width: fit-children;
  margin-right: 10px;
}

.row.row--steppers .row__steppers {
  visibility: visible;
}

.row__stepper {
  width: 30px;
  height: 30px;
  margin-left: 4px;
  vertical-align: center;
}

.row__stepper-glyph {
  font-size: 10px;
}

.menu__empty {
  width: 100%;
  height: 50px;
  text-align: center;
  font-size: 14px;
}

.menu__prompt {
  width: 100%;
  height: fit-children;
  flow-children: down;
  margin-top: 8px;
  padding: 14px;
}

.menu__prompt-text {
  width: 100%;
  font-size: 15px;
}

.menu__prompt-hint {
  width: 100%;
  margin-bottom: 10px;
  font-size: 13px;
}

.menu__footer {
  width: 100%;
  height: 40px;
  flow-children: right;
  margin-top: 10px;
}

.button {
  width: 150px;
  height: 40px;
}

.button__label {
  font-size: 14px;
}

.pager {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: right;
}

.pager__label {
  width: fill-parent-flow(1);
  vertical-align: center;
  margin-right: 14px;
  text-align: right;
  font-size: 14px;
}

.pager__arrow {
  width: 40px;
  height: 100%;
  margin-left: 6px;
}

.pager__glyph {
  horizontal-align: center;
  vertical-align: center;
  font-size: 11px;
}
