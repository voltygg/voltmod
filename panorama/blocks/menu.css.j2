{#- Layout, plus the show/hide rules for the classes PanoramaMenuLayout sets. Colors, borders,
    radii and transitions go in the screen's own stylesheet. -#}
{% include "screen.css.j2" %}
{% include "button.css.j2" %}
{% include "icons.css.j2" %}

.menu {
  width: 920px;
  height: 640px;
  horizontal-align: center;
  vertical-align: center;
  flow-children: right;
}

.menu__sidebar {
  width: 236px;
  height: 100%;
  flow-children: down;
  padding: 22px 14px;
}

.screen.screen--no-sidebar .menu__sidebar {
  visibility: collapse;
}

.screen.screen--no-sidebar .menu {
  width: 684px;
}

.menu__brand {
  width: 100%;
  height: fit-children;
  flow-children: down;
  margin: 0px 10px 24px 10px;
}

.menu__nav {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
}

.tab {
  width: 100%;
  height: 44px;
  margin-bottom: 4px;
  padding: 0px 12px;
  flow-children: right;
}

.tab .icon-set {
  width: 20px;
  height: 20px;
  vertical-align: center;
  margin-right: 12px;
}

.tab__label {
  width: fill-parent-flow(1);
  vertical-align: center;
  font-size: 15px;
  text-overflow: ellipsis;
}

.menu__content {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: down;
  padding: 22px 26px 20px 26px;
}

.menu__header {
  width: 100%;
  height: fit-children;
  flow-children: right;
  margin-bottom: 16px;
}

.menu__header-text {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
}

/* Fixed height, because CSS can't tell when the breadcrumb is empty. This keeps the title from jumping. */
.menu__breadcrumb {
  width: 100%;
  height: 16px;
  font-size: 11px;
  text-overflow: ellipsis;
}

.menu__title {
  width: 100%;
  font-size: 26px;
  font-weight: bold;
  text-overflow: ellipsis;
}

.menu__subtitle {
  width: 100%;
  font-size: 13px;
  text-overflow: ellipsis;
}

.icon-button {
  width: 36px;
  height: 36px;
}

.icon-button__image {
  width: 14px;
  height: 14px;
  horizontal-align: center;
  vertical-align: center;
}

.menu__rows {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
}

/* When the screen provides `home` markup, it replaces the rows on the root menu. */
.menu__home {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
  visibility: collapse;
}

.screen.screen--home .menu__home {
  visibility: visible;
}

.screen.screen--home .menu--with-home .menu__rows {
  visibility: collapse;
}

.row {
  width: 100%;
  height: 48px;
  margin-bottom: 6px;
  flow-children: right;
}

.row__button {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: right;
  padding: 0px 16px 0px 18px;
}

/* Use fit-children, not 100%: a full-height column puts its text at the top instead of centering it. */
.row__body {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
  vertical-align: center;
}

.row__label {
  width: 100%;
  font-size: 15px;
  text-overflow: ellipsis;
}

.row__hint {
  width: 100%;
  font-size: 11px;
  text-overflow: ellipsis;
  visibility: collapse;
}

.row.row--pending .row__hint {
  visibility: visible;
}

.row__value {
  vertical-align: center;
  margin-left: 10px;
  padding: 4px 10px;
  font-size: 13px;
  text-overflow: ellipsis;
  visibility: collapse;
}

.row.row--value .row__value {
  visibility: visible;
}

/* Toggle rows hide their value because the switch already shows ON or OFF. */
.row.row--toggle .row__value {
  visibility: collapse;
}

.row__chevron {
  vertical-align: center;
  margin-left: 12px;
  margin-bottom: 3px;
  font-size: 24px;
  visibility: collapse;
}

.row.row--chevron .row__chevron {
  visibility: visible;
}

.switch {
  width: 44px;
  height: 24px;
  vertical-align: center;
  margin-left: 12px;
  visibility: collapse;
}

.row.row--toggle .switch {
  visibility: visible;
}

.switch__knob {
  width: 18px;
  height: 18px;
  margin-left: 3px;
  vertical-align: center;
  transform: translateX(0px);
}

.row.row--on .switch__knob {
  transform: translateX(20px);
}

.row__steppers {
  width: fit-children;
  height: 100%;
  margin-left: 6px;
  flow-children: right;
  visibility: collapse;
}

.row.row--steppers .row__steppers {
  visibility: visible;
}

.row__stepper {
  width: 34px;
  height: 100%;
  margin-left: 4px;
  vertical-align: center;
  font-size: 11px;
}

/* A Label inside a Button sits in the top-left corner unless you align it. */
.row__stepper-glyph {
  horizontal-align: center;
  vertical-align: center;
  font-size: 10px;
}

.menu__empty {
  width: 100%;
  height: 50px;
  text-align: center;
  font-size: 14px;
}

.menu__prompt {
  width: 100%;
  height: fit-children;
  flow-children: down;
  margin-top: 8px;
  padding: 14px;
}

.menu__prompt-text {
  width: 100%;
  font-size: 15px;
}

.menu__prompt-hint {
  width: 100%;
  margin-bottom: 10px;
  font-size: 13px;
}

.menu__footer {
  width: 100%;
  height: 40px;
  flow-children: right;
  margin-top: 10px;
}

.button {
  width: 140px;
  height: 40px;
}

.button__label {
  font-size: 14px;
}

.pager {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: right;
}

.pager__label {
  width: fill-parent-flow(1);
  vertical-align: center;
  margin-right: 14px;
  text-align: right;
  font-size: 14px;
}

.pager__arrow {
  width: 40px;
  height: 100%;
  margin-left: 6px;
}

.pager__glyph {
  horizontal-align: center;
  vertical-align: center;
  font-size: 11px;
}
