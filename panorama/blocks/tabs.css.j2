/* Layout only. Add colors and borders in the screen's stylesheet after including this file. */
.tabs {
  width: 100%;
  flow-children: right;
}

.tab {
  width: fill-parent-flow(1);
  height: 100%;
  margin-right: 2px;
}

.tab.hidden {
  visibility: collapse;
}

.tab__label {
  horizontal-align: center;
  vertical-align: center;
  font-size: 12px;
  text-overflow: ellipsis;
}
