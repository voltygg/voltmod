.icon-set__icon {
  width: 100%;
  height: 100%;
  visibility: collapse;
}

/* A plain class rather than a `--` modifier, so it doesn't end up in the generated icon names. */
.icon-set.keep-shape .icon-set__icon {
  width: fit-children;
  horizontal-align: center;
}

{#- Adding `icon-set--<name>` to the set shows the icon with that name. `set` is the same list
    the `icons` macro takes. -#}
{% macro show_rules(set) %}
{% for name, _ in set %}
.icon-set--{{name}} .icon-set__icon--{{name}} {
  visibility: visible;
}
{% endfor %}
{%- endmacro %}
