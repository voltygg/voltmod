{#- A centred panel with a header and a body slot. Call it, do not import it:

      {% call blocks.dialog("panel") %}...rows, pager, footer...{% endcall %}

    The header reads three dialog variables off the root: `<id>_breadcrumb`, `<id>_title` and
    `<id>_subtitle`. A breadcrumb keeps its line when empty so the title does not jump. -#}
{% macro dialog(id) -%}
<Panel id="{{screen}}_{{id}}" class="dialog" hittest="true">
  <Panel class="dialog__header" hittest="false">
    <Label class="dialog__breadcrumb" text="{s:{{id}}_breadcrumb}" hittest="false" />
    <Label class="dialog__title" text="{s:{{id}}_title}" hittest="false" />
    <Label id="{{screen}}_{{id}}_subtitle" class="dialog__subtitle" text="{s:{{id}}_subtitle}" hittest="false" />
  </Panel>
  <Panel class="dialog__rule" hittest="false" />
  <Panel class="dialog__body" hittest="true">
    {{ caller() | indent(4) }}
  </Panel>
</Panel>
{%- endmacro %}
