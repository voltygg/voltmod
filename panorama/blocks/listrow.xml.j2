{#- One row of a list: two lines of text, a value, an optional switch and chevron, and optional
    steppers. The row, its button and each stepper carry their own id, so a screen can hide the
    row, read a press and read a step separately. The switch and chevron start collapsed; the
    screen's stylesheet shows them per a class written on the row. -#}
{% macro listrow(id, switch=false, hint=false, value=true, steppers=false, chevron=false) -%}
<Panel id="{{screen}}_{{id}}" class="row hidden" hittest="true">
  <Button id="{{screen}}_{{id}}_button" class="row__button">
    <Panel class="row__body" hittest="false">
      <Label class="row__label" text="{s:{{id}}_label}" hittest="false" />
      {%- if hint %}
      <Label class="row__hint" text="{s:{{id}}_hint}" hittest="false" />
      {%- endif %}
    </Panel>
    {%- if value %}
    <Label class="row__value" text="{s:{{id}}_value}" hittest="false" />
    {%- endif %}
    {%- if switch %}
    <Panel class="switch" hittest="false">
      <Panel class="switch__knob" hittest="false" />
    </Panel>
    {%- endif %}
    {%- if chevron %}
    <Label class="row__chevron" text="&#8250;" hittest="false" />
    {%- endif %}
  </Button>
  {%- if steppers %}
  <Panel class="row__steppers" hittest="true">
    <Button id="{{screen}}_{{id}}_decrease" class="row__stepper">
      <Label class="row__stepper-glyph" text="&#9664;" hittest="false" />
    </Button>
    <Button id="{{screen}}_{{id}}_increase" class="row__stepper">
      <Label class="row__stepper-glyph" text="&#9654;" hittest="false" />
    </Button>
  </Panel>
  {%- endif %}
</Panel>
{%- endmacro %}
