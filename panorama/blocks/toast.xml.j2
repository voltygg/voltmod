{#- A notice that fades in when the driver takes `hidden` off it. -#}
{% macro toast(id) -%}
<Panel id="{{screen}}_{{id}}" class="toast hidden" hittest="false">
  <Panel class="toast__body" hittest="false">
    <Label class="toast__title" text="{s:{{id}}_title}" hittest="false" />
    <Label class="toast__text" text="{s:{{id}}_description}" hittest="false" />
  </Panel>
</Panel>
{%- endmacro %}
