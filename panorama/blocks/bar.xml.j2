{#- A meter. The driver picks the fill width by writing `bar--step-k` on the bar, k of the steps its
    stylesheet declares, and takes the whole bar away with `hidden`. -#}
{% macro bar(id) -%}
<Panel id="{{screen}}_{{id}}" class="bar" hittest="false">
  <Panel class="bar__fill" hittest="false" />
</Panel>
{%- endmacro %}
