/* Layout only. Add colors and borders in the screen's stylesheet after including this file. */
.pager {
  width: 100%;
  flow-children: right;
}

.pager__arrow {
  width: 28px;
  height: 100%;
  font-size: 11px;
}

/* A Label inside a Button sits in the top-left corner unless you align it. */
.pager__glyph {
  horizontal-align: center;
  vertical-align: center;
}

.pager__label {
  width: fill-parent-flow(1);
  horizontal-align: center;
  vertical-align: center;
  text-align: center;
  font-size: 12px;
}
