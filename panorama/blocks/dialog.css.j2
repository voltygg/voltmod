/* Layout only. Add colors and borders in the screen's stylesheet after including this file. */
.dialog {
  height: fit-children;
  horizontal-align: center;
  vertical-align: center;
  flow-children: down;
}

.dialog__header {
  width: 100%;
  height: fit-children;
  flow-children: down;
  padding: 14px 16px 10px 16px;
}

/* Fixed height, because CSS can't tell when the breadcrumb is empty. This keeps the title from jumping. */
.dialog__breadcrumb {
  width: 100%;
  height: 14px;
  font-size: 12px;
  text-overflow: ellipsis;
}

.dialog__title {
  width: 100%;
  font-size: 22px;
  font-weight: bold;
  text-overflow: ellipsis;
}

.dialog__subtitle {
  width: 100%;
  font-size: 13px;
  text-overflow: ellipsis;
}

.dialog__rule {
  width: 100%;
  height: 1px;
}

.dialog__body {
  width: 100%;
  height: fit-children;
  flow-children: down;
  padding: 10px 16px 14px 16px;
}
