/* Layout only. A screen sets width, colour and radius after including this. */
.dialog {
  height: fit-children;
  horizontal-align: center;
  vertical-align: center;
  flow-children: down;
}

.dialog__header {
  width: 100%;
  height: fit-children;
  flow-children: down;
  padding: 14px 16px 10px 16px;
}

/* Fixed height: empty at the root, and CSS cannot test that, so it holds its line. */
.dialog__breadcrumb {
  width: 100%;
  height: 14px;
  font-size: 12px;
  text-overflow: ellipsis;
}

.dialog__title {
  width: 100%;
  font-size: 22px;
  font-weight: bold;
  text-overflow: ellipsis;
}

.dialog__subtitle {
  width: 100%;
  font-size: 13px;
  text-overflow: ellipsis;
}

.dialog__subtitle.hidden {
  visibility: collapse;
}

.dialog__rule {
  width: 100%;
  height: 1px;
}

.dialog__body {
  width: 100%;
  height: fit-children;
  flow-children: down;
  padding: 10px 16px 14px 16px;
}
